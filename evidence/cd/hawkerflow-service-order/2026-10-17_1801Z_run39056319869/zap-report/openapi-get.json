{
  "openapi": "3.1.0",
  "info": {
    "title": "Hawkerflow Service Order",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/order/orders/queue/{order_ref}": {
      "get": {
        "summary": "Get Queued Order",
        "description": "Looks up an order placed through order_queue. API Gateway puts the diner's\norder straight on the queue under an order_ref the diner chose; this\nanswers 202 PENDING until the SQS worker has created it, then its order_id.",
        "operationId": "get_queued_order_v1_order_orders_queue__order_ref__get",
        "parameters": [
          {
            "name": "order_ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Order Ref"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/order/orders/{order_id}": {
      "get": {
        "summary": "Get Order",
        "operationId": "get_order_v1_order_orders__order_id__get",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Order Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/order/stalls/me/orders": {
      "get": {
        "summary": "Get My Stall Orders",
        "description": "Fetch all orders belonging to the currently authenticated hawker's stall.\nHawkers only ever receive dishes and orders intended for their stall.",
        "operationId": "get_my_stall_orders_v1_order_stalls_me_orders_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "X-Stall-ID",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Stall-Id"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/order/stalls/{stall_id}/orders": {
      "get": {
        "summary": "Get Stall Orders",
        "description": "Fetch all orders for a specific stall ID.\nEnforces that caller is authenticated and authorized for that stall_id.",
        "operationId": "get_stall_orders_v1_order_stalls__stall_id__orders_get",
        "parameters": [
          {
            "name": "stall_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Stall Id"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "X-Stall-ID",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Stall-Id"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/order/sqs/status": {
      "get": {
        "summary": "Get Sqs Worker Status",
        "description": "Check the current health and operational status of the SQS background poller.",
        "operationId": "get_sqs_worker_status_v1_order_sqs_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Dish": {
        "properties": {
          "dish_id": {
            "type": "integer",
            "title": "Dish Id"
          },
          "dish_name": {
            "type": "string",
            "title": "Dish Name"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          },
          "price": {
            "type": "number",
            "title": "Price"
          }
        },
        "type": "object",
        "required": [
          "dish_id",
          "dish_name",
          "quantity",
          "price"
        ],
        "title": "Dish"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Order": {
        "properties": {
          "stall_id": {
            "type": "integer",
            "title": "Stall Id"
          },
          "dishes": {
            "items": {
              "$ref": "#/components/schemas/Dish"
            },
            "type": "array",
            "title": "Dishes"
          }
        },
        "type": "object",
        "required": [
          "stall_id",
          "dishes"
        ],
        "title": "Order"
      },
      "OrderDetails": {
        "properties": {
          "orders": {
            "items": {
              "$ref": "#/components/schemas/Order"
            },
            "type": "array",
            "title": "Orders"
          },
          "total_price": {
            "type": "number",
            "title": "Total Price"
          },
          "dining_option": {
            "type": "string",
            "enum": [
              "dine_in",
              "takeaway"
            ],
            "title": "Dining Option",
            "default": "dine_in"
          },
          "takeaway_fee": {
            "type": "number",
            "minimum": 0.0,
            "title": "Takeaway Fee",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "orders",
          "total_price"
        ],
        "title": "OrderDetails"
      },
      "OrderUpdate": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "order_id": {
            "type": "integer",
            "title": "Order Id"
          }
        },
        "type": "object",
        "required": [
          "status",
          "order_id"
        ],
        "title": "OrderUpdate"
      },
      "StallOrderUpdate": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "StallOrderUpdate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "servers": [
    {
      "url": "/order"
    }
  ]
}
